{
  "name": "mutorials.org",
  "version": "0.0.0",
  "scripts": {
    "start": "node index.js",
    "dev": "run-p dev:*",
    "dev:sync": "browser-sync start --no-notify --no-open --proxy=localhost:3000 --port=3001 --files=\"**/*\" --reload-delay=100",
    "dev:express": "nodemon index.js",
    "dev:css": "tailwindcss -i public/css/tailwind.css -o public/css/style.css --watch",
    "build": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/style.css",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=120000 \"tests/**/*.test.js\"",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Mu-Foundation/Mutorials.git"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bad-words": "^3.0.4",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-flash-messages": "^0.1.1",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.17.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.3",
    "nanoid": "^3.1.31",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.7.0",
    "browser-sync": "^3.0.4",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.33",
    "postcss-import": "^17.0.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.19"
  }
}
