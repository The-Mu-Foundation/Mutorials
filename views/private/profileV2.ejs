<%
  const subjectMeta = {
    Physics:   { textNum: 'text-sky-600',     accentBar: 'bg-sky-500',     ring: 'ring-sky-500/30' },
    Chemistry: { textNum: 'text-amber-600',   accentBar: 'bg-amber-500',   ring: 'ring-amber-500/30' },
    Biology:   { textNum: 'text-emerald-600', accentBar: 'bg-emerald-500', ring: 'ring-emerald-500/30' },
  };
%>

<%- contentFor('head') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.min.js"></script>
<style>
  .stat-num { font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
</style>
<script>
  window.addEventListener('load', function () {
    Chart.pluginService.register({
      beforeDraw: function (chart) {
        if (chart.config.options.correctwrongPlugin) {
          var width = chart.chart.width;
          var height = chart.chart.height;
          var ctx = chart.chart.ctx;
          ctx.restore();
          ctx.font = '600 0.95em Inter, sans-serif';
          ctx.textBaseline = 'middle';
          ctx.fillStyle = '#10b981';
          var t1 = 'Correct <%= Math.round(100*(user.stats.correct)/(user.stats.correct+user.stats.wrong)) %>%';
          var x1 = Math.round((width - ctx.measureText(t1).width) / 2);
          ctx.fillText(t1, x1, (height / 2) - 12);
          ctx.fillStyle = '#ef4444';
          var t2 = 'Wrong <%= Math.round(100*(user.stats.wrong)/(user.stats.correct+user.stats.wrong)) %>%';
          var x2 = Math.round((width - ctx.measureText(t2).width) / 2);
          ctx.fillText(t2, x2, (height / 2) + 12);
          ctx.save();
        }
      }
    });

    new Chart(document.getElementById('correctWrongChart'), {
      type: 'pie',
      data: {
        labels: ['Correct', 'Wrong'],
        datasets: [{
          data: [$('#correctcount').val(), $('#wrongcount').val()],
          backgroundColor: ['rgba( 16, 185, 129, 1)', 'rgba(239,  68,  68, 1)'],
          borderColor: ['#fff', '#fff'],
          borderWidth: 3,
        }]
      },
      options: {
        correctwrongPlugin: true,
        legend: { display: false },
        cutoutPercentage: 65,
        responsive: true,
        maintainAspectRatio: false,
      }
    });

    let ratingData = { Physics: [], Chemistry: [], Biology: [], Labels: [] };
    ['Physics', 'Chemistry', 'Biology'].forEach((subject) => {
      let tracker = $('#ratingTrackerArray-' + subject).val().split('@');
      if (tracker.length < 2) tracker.unshift(tracker[0]);
      ratingData[subject] = tracker;
    });
    const labelLength = Math.max(ratingData.Physics.length, ratingData.Chemistry.length, ratingData.Biology.length);
    let labels = ratingData.Labels;
    for (let i = labelLength; i > 0; i--) labels.push(i + ' Ago');
    labels.push('');
    ratingData.Labels = labels;

    new Chart(document.getElementById('ratingTrackerChart'), {
      type: 'line',
      data: {
        labels: ratingData.Labels,
        datasets: [
          { label: 'Physics',   data: ratingData.Physics,   backgroundColor: 'rgba( 14, 165, 233, 1)', borderColor: 'rgba( 14, 165, 233, 1)', fill: false, borderWidth: 3, pointRadius: 2 },
          { label: 'Chemistry', data: ratingData.Chemistry, backgroundColor: 'rgba(245, 158,  11, 1)', borderColor: 'rgba(245, 158,  11, 1)', fill: false, borderWidth: 3, pointRadius: 2 },
          { label: 'Biology',   data: ratingData.Biology,   backgroundColor: 'rgba( 16, 185, 129, 1)', borderColor: 'rgba( 16, 185, 129, 1)', fill: false, borderWidth: 3, pointRadius: 2 },
        ]
      },
      options: {
        legend: { display: true, position: 'bottom', labels: { boxWidth: 12, padding: 12 } },
        scales: {
          yAxes: [{
            gridLines: { color: 'rgba(0,0,0,0.04)' },
            ticks: {
              min: Math.round((Math.min(Math.min.apply(null, ratingData.Physics), Math.min.apply(null, ratingData.Chemistry), Math.min.apply(null, ratingData.Biology)) - 50) / 50) * 50,
              max: Math.round((Math.max(Math.max.apply(null, ratingData.Physics), Math.max.apply(null, ratingData.Chemistry), Math.max.apply(null, ratingData.Biology)) + 50) / 50) * 50,
              stepSize: 50,
            }
          }],
          xAxes: [{ gridLines: { display: false }, ticks: { display: false } }]
        },
        responsive: true,
        maintainAspectRatio: false,
      }
    });
  });
</script>

<%- contentFor('main') %>
<div class="w-full">

  <%# Hero %>
  <section class="w-full">
    <div class="max-w-5xl mx-auto px-6 pt-10 pb-6">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 mb-2">Profile</p>
      <h1 class="text-4xl sm:text-5xl tracking-tight">
        <span class="bg-clip-text text-transparent bg-gradient-to-br from-blue-600 to-indigo-600"><%= user.ign %></span>
      </h1>
      <% try { %>
        <% const xp = experienceStats; %>
        <% const xpPct = Math.round(100 * xp.remainder / xp.totalToNext); %>
        <div class="mt-6 max-w-xl">
          <div class="flex items-baseline justify-between mb-2">
            <p class="text-sm font-medium">Level <span class="stat-num"><%= xp.level %></span></p>
            <p class="text-xs text-neutral-500 stat-num"><%= xp.remainder %> / <%= xp.totalToNext %> XP</p>
          </div>
          <div class="w-full h-2 rounded-full bg-neutral-100 overflow-hidden">
            <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-500 transition-all" style="width: <%= xpPct %>%"></div>
          </div>
        </div>
      <% } catch (err) { %><% } %>
    </div>
  </section>

  <section class="w-full bg-neutral-50 border-y border-neutral-200">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <%# Info card %>
        <aside class="lg:col-span-4">
          <div class="rounded-2xl border border-neutral-200 bg-white p-6">
            <p class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500">About</p>
            <h3 class="text-2xl font-bold tracking-tight mt-1">
              <%= user.profile.name
                    ? (user.profile.name.length <= 18 ? user.profile.name : user.profile.name.substring(0, 15) + '...')
                    : (user.ign.length <= 18 ? user.ign : user.ign.substring(0, 15) + '...') %>
            </h3>

            <dl class="mt-6 space-y-4 text-sm">
              <% if (user.profile.yob) { %>
                <div>
                  <dt class="text-xs uppercase tracking-wider text-neutral-500">Age</dt>
                  <dd class="mt-1 stat-num"><%= age %></dd>
                </div>
              <% } %>
              <div>
                <dt class="text-xs uppercase tracking-wider text-neutral-500">Location</dt>
                <dd class="mt-1"><%= user.profile.location ? user.profile.location : 'Lives within 8000 miles of Antarctica' %></dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-neutral-500">Bio</dt>
                <dd class="mt-1 text-neutral-700"><%= user.profile.bio ? user.profile.bio : 'A very mysterious person who likes pink butterflies and blue cows. Mu!' %></dd>
              </div>
            </dl>

            <div class="mt-6 pt-6 border-t border-neutral-200">
              <p class="text-xs uppercase tracking-wider text-neutral-500 mb-3">Achievements</p>
              <% let achievementCount = 0; %>
              <ul class="space-y-1.5 text-sm">
                <% for (const achievement in allAchievements) { %>
                  <% if (user.achievements[achievement]) { %>
                    <li class="flex items-center gap-2"><i class="fas fa-medal text-amber-500 text-xs"></i> <%= allAchievements[achievement].name %></li>
                    <% achievementCount++; %>
                  <% } %>
                <% } %>
              </ul>
              <% if (achievementCount === 0) { %>
                <p class="text-sm text-neutral-400 italic">None yet</p>
              <% } %>
            </div>
          </div>
        </aside>

        <%# Charts + tags %>
        <div class="lg:col-span-8 flex flex-col gap-6">

          <div class="grid grid-cols-1 sm:grid-cols-5 gap-6">
            <div class="sm:col-span-3 rounded-2xl border border-neutral-200 bg-white p-5">
              <p class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 mb-4">Rating history</p>
              <div class="w-full" style="height: 240px;">
                <canvas id="ratingTrackerChart"></canvas>
              </div>
            </div>
            <div class="sm:col-span-2 rounded-2xl border border-neutral-200 bg-white p-5 flex flex-col">
              <p class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 mb-4">Performance</p>
              <div class="w-full flex-1 min-h-[180px]" style="height: 200px;">
                <canvas id="correctWrongChart"></canvas>
              </div>
              <a class="mt-3 text-sm text-blue-600 hover:underline text-center" target="_blank" href="/stats/<%= user.ign %>">See full stats →</a>
            </div>
          </div>

          <input type="hidden" id="ratingTrackerArray-Physics"   value="<%= user.stats.ratingTracker.physics.join('@') %>">
          <input type="hidden" id="ratingTrackerArray-Chemistry" value="<%= user.stats.ratingTracker.chemistry.join('@') %>">
          <input type="hidden" id="ratingTrackerArray-Biology"   value="<%= user.stats.ratingTracker.biology.join('@') %>">
          <input type="hidden" id="correctcount" value="<%= user.stats.correct %>">
          <input type="hidden" id="wrongcount"   value="<%= user.stats.wrong %>">

          <div class="rounded-2xl border border-neutral-200 bg-white p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-medium tracking-[0.2em] uppercase text-rose-600">Problem Rush</p>
                <h3 class="text-2xl font-bold tracking-tight mt-1">High Score</h3>
              </div>
              <p class="text-5xl font-extrabold stat-num text-rose-600"><%= user.stats.rush.highscore ? user.stats.rush.highscore : 0 %></p>
            </div>
          </div>

          <div class="rounded-2xl border border-neutral-200 bg-white p-6">
            <p class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 mb-4">Collected tags</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
              <% ['Physics', 'Chemistry', 'Biology'].forEach((subject) => { %>
                <% const meta = subjectMeta[subject]; %>
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    <span class="w-2 h-2 rounded-full <%= meta.accentBar %>"></span>
                    <h4 class="text-sm font-medium"><%= subject %></h4>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    <% let counter = 0; %>
                    <% user.stats.collectedTags.forEach((tag) => { %>
                      <% if (Object.keys(totalTags[subject]['Units']).includes(tag)) { %>
                        <span class="inline-flex items-center px-2 py-0.5 text-xs rounded bg-blue-50 text-blue-700 border border-blue-200"><%= tag %></span>
                        <% counter++; %>
                      <% } else if (Object.keys(totalTags[subject]['Concepts']).includes(tag)) { %>
                        <span class="inline-flex items-center px-2 py-0.5 text-xs rounded bg-cyan-50 text-cyan-700 border border-cyan-200"><%= tag %></span>
                        <% counter++; %>
                      <% } %>
                    <% }) %>
                  </div>
                  <% const totalForSubject = Object.keys(totalTags[subject]['Units']).length + Object.keys(totalTags[subject]['Concepts']).length %>
                  <p class="text-xs text-neutral-500 mt-3 stat-num"><%= counter %> / <%= totalForSubject %> collected</p>
                </div>
              <% }) %>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

</div>
