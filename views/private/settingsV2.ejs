<%- contentFor('main') %>
<div
  class="w-full"
  x-data="{ unsaved: false, showDeleteConfirm: false, showPwReq: false }"
>

  <%# Hero %>
  <section class="w-full">
    <div class="max-w-3xl mx-auto px-6 pt-10 pb-6">
      <p class="text-xs font-medium tracking-[0.2em] uppercase text-neutral-500 mb-2">Account</p>
      <h1 class="text-4xl sm:text-5xl tracking-tight">Settings</h1>
      <p class="text-neutral-600 mt-3">Tweak your profile, preferences, and account.</p>

      <div
        x-show="unsaved"
        x-cloak
        x-transition
        class="mt-6 px-4 py-3 rounded-xl border border-orange-200 bg-orange-50 text-orange-900 text-sm flex items-center gap-2"
      >
        <i class="fas fa-exclamation-circle"></i>
        Careful — you have unsaved changes.
      </div>
    </div>
  </section>

  <section class="w-full bg-neutral-50 border-y border-neutral-200">
    <div class="max-w-3xl mx-auto px-6 py-10 flex flex-col gap-6">

      <%# Profile %>
      <form action="/changeProfile" method="POST" class="rounded-2xl border border-neutral-200 bg-white p-6">
        <div class="flex items-baseline justify-between mb-1">
          <h2 class="text-xl font-bold tracking-tight">Profile</h2>
          <span class="text-xs uppercase tracking-wider text-neutral-400">Public</span>
        </div>
        <p class="text-sm text-neutral-600 mb-6">Shown on your profile page.</p>

        <div class="space-y-4">
          <% [
            { id: 'name', label: 'Name', type: 'text', value: user.profile.name, ph: 'Enter your name' },
            { id: 'bio',  label: 'Bio',  type: 'text', value: user.profile.bio, ph: 'Introduce yourself' },
            { id: 'location', label: 'Location', type: 'text', value: user.profile.location, ph: 'Where do you live?' },
            { id: 'yob', label: 'Year of Birth', type: 'number', value: user.profile.yob, ph: 'Year of birth' },
          ].forEach((f) => { %>
            <div class="grid grid-cols-1 sm:grid-cols-12 sm:items-center gap-2">
              <label for="<%= f.id %>" class="sm:col-span-3 text-sm font-medium"><%= f.label %></label>
              <input
                type="<%= f.type %>"
                id="<%= f.id %>"
                name="<%= f.id %>"
                class="sm:col-span-9"
                value="<%= f.value %>"
                placeholder="<%= f.ph %>"
                @input="unsaved = true"
              >
            </div>
          <% }) %>
        </div>

        <div class="mt-6 pt-6 border-t border-neutral-200">
          <input class="btn btn-primary" type="submit" value="Update Profile">
        </div>
      </form>

      <%# Personalization %>
      <form action="/changePreferences" method="POST" class="rounded-2xl border border-neutral-200 bg-white p-6">
        <div class="flex items-baseline justify-between mb-1">
          <h2 class="text-xl font-bold tracking-tight">Personalization</h2>
          <span class="text-xs uppercase tracking-wider text-neutral-400">Private</span>
        </div>
        <p class="text-sm text-neutral-600 mb-6">Adjust how Mutorials looks and what others see.</p>

        <div class="space-y-3">
          <label class="flex items-start gap-3 p-3 rounded-lg hover:bg-neutral-50 transition cursor-pointer">
            <input type="checkbox" id="darkMode" name="darkMode" class="mt-0.5" <% if (locals.darkMode) { %>checked<% } %>>
            <div>
              <p class="text-sm font-medium">Dark Mode</p>
              <p class="text-xs text-neutral-500">Easier on the eyes at night.</p>
            </div>
          </label>
          <label class="flex items-start gap-3 p-3 rounded-lg hover:bg-neutral-50 transition cursor-pointer">
            <input type="checkbox" id="hideProfile" name="hideProfile" class="mt-0.5" <% if (user.preferences.hideProfile) { %>checked<% } %>>
            <div>
              <p class="text-sm font-medium">Hide public profile and stats</p>
              <p class="text-xs text-neutral-500">Other users won't be able to view your profile.</p>
            </div>
          </label>
        </div>

        <div class="mt-6 pt-6 border-t border-neutral-200">
          <input class="btn btn-primary" type="submit" value="Update Preferences">
        </div>
      </form>

      <%# Account %>
      <form action="/changeSettings" method="POST" class="rounded-2xl border border-neutral-200 bg-white p-6">
        <div class="flex items-baseline justify-between mb-1">
          <h2 class="text-xl font-bold tracking-tight">Account</h2>
          <span class="text-xs uppercase tracking-wider text-neutral-400">Sign-in</span>
        </div>
        <p class="text-sm text-neutral-600 mb-6">Username, email, and password.</p>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-12 sm:items-center gap-2">
            <label for="ign" class="sm:col-span-3 text-sm font-medium">Username</label>
            <input type="text" id="ign" name="ign" class="sm:col-span-9" value="<%= user.ign %>" placeholder="Change your username" @input="unsaved = true">
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-12 sm:items-center gap-2">
            <label for="username" class="sm:col-span-3 text-sm font-medium">Email</label>
            <input type="text" id="username" name="username" class="sm:col-span-9" value="<%= user.username %>" placeholder="Change your linked email" @input="unsaved = true">
          </div>

          <div class="pt-2">
            <p class="text-sm font-medium mb-3">Change password</p>
            <div class="space-y-2">
              <input type="password" id="plassword" name="plassword" placeholder="Current password">
              <input
                type="password" id="newpw" name="newpw" placeholder="New password"
                @focus="showPwReq = true"
                @blur="setTimeout(() => showPwReq = false, 1000)"
              >
              <input type="password" id="password" name="confirmnewpw" placeholder="Confirm new password">
              <p
                x-show="showPwReq"
                x-cloak
                x-transition
                class="text-xs text-neutral-500 px-3"
              >
                Min <strong>7 characters</strong> with at least <strong>1 letter</strong> and <strong>1 number</strong>.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-6 border-t border-neutral-200">
          <input class="btn btn-primary" type="submit" value="Update Account">
        </div>
      </form>

      <%# Delete Account %>
      <form id="delete-account-form" action="/deleteAccount" method="POST" class="rounded-2xl border border-red-200 bg-red-50/50 p-6">
        <div class="flex items-baseline justify-between mb-1">
          <h2 class="text-xl font-bold tracking-tight text-red-900">Delete account</h2>
          <span class="text-xs uppercase tracking-wider text-red-400">Permanent</span>
        </div>
        <p class="text-sm text-red-800/80 mb-6">This deletes your account and all data. There is no undo.</p>

        <div class="grid grid-cols-1 sm:grid-cols-12 sm:items-center gap-2">
          <label for="delassword" class="sm:col-span-3 text-sm font-medium">Password</label>
          <input type="password" id="delassword" name="delassword" class="sm:col-span-9" placeholder="Confirm with your current password">
        </div>

        <div class="mt-6 pt-6 border-t border-red-200">
          <button
            type="button"
            class="btn bg-red-600 hover:bg-red-700 text-white"
            @click="showDeleteConfirm = true"
          >Delete Account</button>
        </div>
      </form>

    </div>
  </section>

  <%# Modal %>
  <div
    x-show="showDeleteConfirm"
    x-cloak
    class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-900/60 backdrop-blur-sm px-4"
    @click.self="showDeleteConfirm = false"
    @keydown.escape.window="showDeleteConfirm = false"
  >
    <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full overflow-hidden border border-neutral-200" x-transition>
      <div class="p-6">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-red-100 text-red-600 mx-auto mb-4">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 class="text-lg font-bold tracking-tight text-center">Delete your account?</h3>
        <p class="text-sm text-neutral-600 text-center mt-2">This action cannot be undone. All your data, ratings, and progress will be permanently deleted.</p>
      </div>
      <div class="px-6 py-4 bg-neutral-50 border-t border-neutral-200 flex justify-end gap-2">
        <button type="button" class="btn btn-outline" @click="showDeleteConfirm = false">Cancel</button>
        <button
          type="button"
          class="btn bg-red-600 hover:bg-red-700 text-white"
          @click="document.getElementById('delete-account-form').submit()"
        >Yes, delete</button>
      </div>
    </div>
  </div>
</div>
